<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".Activitys.PinResetApp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glVertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.45" />

    <LinearLayout
        android:id="@+id/llLeft"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toStartOf="@+id/glVertical"
        app:layout_constraintStart_toStartOf="parent">

        <com.wang.avi.AVLoadingIndicatorView
            android:id="@+id/avi"
            style="@style/AVLoadingIndicatorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:indicatorColor="@color/colorPrimary"
            app:indicatorName="BallPulseIndicator" />

        <TextView
            android:id="@+id/txtTextoPin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Verificando PIN..."
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMensajeConfirmacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ingrese el PIN"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/llIndicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/circle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/pin_indicator_margin"
                android:src="@drawable/circle_void" />

            <ImageView
                android:id="@+id/circle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/pin_indicator_margin"
                android:src="@drawable/circle_void" />

            <ImageView
                android:id="@+id/circle3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/pin_indicator_margin"
                android:src="@drawable/circle_void" />

            <ImageView
                android:id="@+id/circle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/pin_indicator_margin"
                android:src="@drawable/circle_void" />

            <ImageView
                android:id="@+id/circle5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/pin_indicator_margin"
                android:src="@drawable/circle_void" />

            <ImageView
                android:id="@+id/circle6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/pin_indicator_margin"
                android:src="@drawable/circle_void" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/glVertical"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnNumber1"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="1" />

        <Button
            android:id="@+id/btnNumber2"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="2" />

        <Button
            android:id="@+id/btnNumber3"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="3" />

        <Button
            android:id="@+id/btnNumber4"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="4" />

        <Button
            android:id="@+id/btnNumber5"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="5" />

        <Button
            android:id="@+id/btnNumber6"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="6" />

        <Button
            android:id="@+id/btnNumber7"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="7" />

        <Button
            android:id="@+id/btnNumber8"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="8" />

        <Button
            android:id="@+id/btnNumber9"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="9" />

        <View
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:layout_margin="@dimen/pin_button_margin" />

        <Button
            android:id="@+id/btnNumber0"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:text="0" />

        <ImageButton
            android:id="@+id/btnNumberDelete"
            style="@style/ButtonPin"
            android:layout_width="@dimen/pin_button_size"
            android:layout_height="@dimen/pin_button_size"
            android:padding="20dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/backspace"
            app:tint="@color/colorIconDelete" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>