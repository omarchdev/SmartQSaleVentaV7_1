<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_ventas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Fragment.VentasFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rVentas"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/linearLayoutButtonSales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Content Area (Left) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/AppTheme.Card.Modern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <ImageButton
                                android:id="@+id/imgBackGrid"
                                style="@style/AppTheme.Button.Icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:srcCompat="@drawable/arrow_back_grid" />

                            <androidx.appcompat.widget.SearchView
                                android:id="@+id/edtSearchProduct"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_edittext_modern"
                                android:backgroundTint="@color/white"
                                app:iconifiedByDefault="false"
                                app:queryHint="Buscar..." />

                            <ImageButton
                                android:visibility="gone"
                                android:id="@+id/imgBtnScan"
                                style="@style/AppTheme.Button.Icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="4dp"
                                app:srcCompat="@drawable/ic_barcode_scan_white_24dp"
                                app:tint="@color/status_success" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvProductsInSale"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:padding="8dp" />

                        <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/avi"
                            style="@style/AVLoadingIndicatorView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:indicatorColor="@color/colorPrimary"
                            app:indicatorName="BallScaleMultipleIndicator" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Sidebar Cart (Right) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/AppTheme.Card.Modern"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:layout_margin="8dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            style="@style/AppTheme.Sales.ActionBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:elevation="0dp"
                            android:padding="4dp">

                            <Button
                                android:id="@+id/btnElegirVendedor"
                                style="@style/AppTheme.Sales.ActionButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vnd."
                                app:icon="@drawable/ic_account_plus_white_24dp" />

                            <ImageButton
                                android:id="@+id/imgLock"
                                style="@style/AppTheme.Button.Icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:srcCompat="@drawable/ic_lock_open_variant_white_24dp"
                                app:tint="@color/gray_600" />

                            <Button
                                android:id="@+id/btnElegirCliente"
                                style="@style/AppTheme.Sales.ActionButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cli."
                                app:icon="@drawable/ic_human_male_female_white_24dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/gray_100" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/txtCantidadProducto"
                                    style="@style/AppTheme.Sales.QuantityBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="x0" />

                                <TextView
                                    android:id="@+id/txtPrecioUltimoProductoEnCarrito"
                                    style="@style/AppTheme.Sales.PriceText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:text="S/ 0.00"
                                    android:textSize="18sp" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnCobrar"
                                style="@style/AppTheme.Sales.CheckoutButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="COBRAR" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCarritoVenta"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:padding="8dp">

                            <Button
                                android:id="@+id/btnCancelarVenta"
                                style="@style/AppTheme.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="ANULAR"
                                android:textColor="@color/status_error"
                                android:textSize="10sp"
                                app:strokeColor="@color/status_error" />

                            <ImageButton
                                android:id="@+id/btnOpenGuardarPedido"
                                style="@style/AppTheme.Button.Icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_edittext_modern"
                                android:backgroundTint="@color/gray_100"
                                app:srcCompat="@drawable/save_white"
                                app:tint="@color/colorPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Compatibility IDs & Hidden Views -->
            <EditText android:id="@+id/edtCodigoBarra" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <RelativeLayout android:id="@+id/content_venta1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <RelativeLayout android:id="@+id/content_venta2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ImageButton android:id="@+id/imgTipoVistaLista" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Spinner android:id="@+id/spinnerCategoria" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvGridarticulosVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/txtTextoCarrito" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ProgressBar android:id="@+id/pbPedido" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/linearLayoutBtnDetalleVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/layoutInfo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/txtNombreUltimoProductoEnCarrito" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ImageButton android:id="@+id/imgArrowDisplay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <com.sothree.slidinguppanel.SlidingUpPanelLayout android:id="@+id/sliding_layout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:gravity="bottom" />
            <RelativeLayout android:id="@+id/linearContenedorVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/txtDescuentoPrecioVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnZonaServicio" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnModoVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/edtPlaca" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/edtHoraIngreso" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/edtHoraSalida" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/edtTiempoTranscurrido" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/edtEtapaCont" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/edtEspaciosLibres" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/edtObservacion" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ImageButton android:id="@+id/btnHoraInit" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <ImageButton android:id="@+id/btnHoraFin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/txtEstadoPermitir" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
