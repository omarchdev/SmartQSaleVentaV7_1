<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Activitys.HistorialVentas">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardControls"
        style="@style/AppTheme.Card.Modern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/contentFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDateVentas1"
                    style="@style/AppTheme.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="31/12/2017"
                    app:icon="@drawable/calendar" />

                <Button
                    android:id="@+id/btnDateVentas2"
                    style="@style/AppTheme.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="31/12/2017"
                    app:icon="@drawable/calendar"
                    app:iconGravity="end" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="12dp"
                android:background="@color/gray_200" />

            <RelativeLayout
                android:id="@+id/contentCliente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/gray_50"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/btnSelectCliente"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_toStartOf="@id/btnDeleteCliente"
                    android:gravity="center_vertical"
                    android:text="Seleccione un cliente"
                    android:textColor="@color/gray_700"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnDeleteCliente"
                    style="@style/AppTheme.Button.Icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/close_outline"
                    app:tint="@color/status_error" />
            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorialVentas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/contentTotal"
        app:layout_constraintTop_toBottomOf="@+id/cardControls" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contentTotal"
        style="@style/AppTheme.Card.Modern"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="8dp"
        app:cardBackgroundColor="@color/gray_900"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="VALOR TOTAL"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTotalDatoVentas"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:text="S/ 0.00"
                android:textColor="@color/status_success"
                android:textSize="24sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Legacy Compatibility -->
    <View android:id="@+id/contentControl" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
