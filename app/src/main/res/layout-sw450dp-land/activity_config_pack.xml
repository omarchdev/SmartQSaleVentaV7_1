<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Activitys.ActivityConfigPack">

    <com.wang.avi.AVLoadingIndicatorView
        android:id="@+id/pbIndicator"
        style="@style/AVLoadingIndicatorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        android:visibility="gone"
        app:indicatorColor="@color/colorAccent"
        app:indicatorName="BallPulseIndicator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Left Panel: Pack Items -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppTheme.Card.Modern"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp">

            <RelativeLayout
                android:id="@+id/contentPack"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/headerControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sComboRapido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Combo Rápido"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/contentButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnModificar"
                            style="@style/AppTheme.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Editar"
                            app:icon="@drawable/pencil_edit" />

                        <Button
                            android:id="@+id/btnEliminarProducto"
                            style="@style/AppTheme.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Borrar"
                            android:textColor="@color/status_error"
                            app:icon="@drawable/ic_delete_grey600_24dp"
                            app:iconTint="@color/status_error"
                            app:strokeColor="@color/status_error" />

                        <Button
                            android:id="@+id/btnOrdenar"
                            style="@style/AppTheme.Button.Icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            app:srcCompat="@drawable/settings" />
                    </LinearLayout>
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/Cabecera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/headerControls"
                    android:background="@color/gray_100"
                    android:padding="8dp">

                    <TextView android:id="@+id/textView14" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Artículo" android:textStyle="bold" />
                    <TextView android:id="@+id/textView18" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:text="Cant." android:textSize="12sp" />
                    <TextView android:id="@+id/textView13" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="Categoría" android:textSize="12sp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProductPack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/Cabecera" />

                <!-- Legacy -->
                <TextView android:id="@+id/textView8" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/contentFechaCompra" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/lContent" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <Button android:id="@+id/btnAgregarProducto" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right Panel: Selector -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AppTheme.Card.Modern"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_margin="4dp">

            <RelativeLayout
                android:id="@+id/contentProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/svProduct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_modern"
                    app:iconifiedByDefault="false"
                    app:queryHint="Buscar..." />

                <LinearLayout
                    android:id="@+id/selectorActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/svProduct"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinnerCategoria"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnAgregarPack"
                        style="@style/AppTheme.Button.Modern"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Agregar" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSelectProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/selectorActions"
                    android:layout_marginTop="8dp" />

                <!-- Legacy -->
                <TextView android:id="@+id/txtTituloProducto" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/textView16" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/txtMen" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <RelativeLayout android:id="@+id/rlContentt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/textView10" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <SearchView android:id="@+id/svFiltroProductPack" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <EditText android:id="@+id/edtParametro" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <Button android:id="@+id/btnCancelarInsertar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <ImageButton android:id="@+id/imgHidePanel" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <TextView
        android:id="@+id/txtCargando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cargando..."
        android:textColor="@color/colorAccent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pbIndicator" />

</androidx.constraintlayout.widget.ConstraintLayout>
