<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppTheme.Card.Modern"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glVertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.4" />

        <!-- Left Panel: Info (matching base background) -->
        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintEnd_toStartOf="@+id/glVertical"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/txtTipodePago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext_modern"
                android:backgroundTint="@color/status_info"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="VALOR ORIGINAL"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtValorOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="S/ 0.00"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginVertical="24dp"
                android:background="@color/white"
                android:alpha="0.3" />

            <TextView
                android:id="@+id/lblRecibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECIBIDO"
                android:textColor="@color/gray_100"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/money_cash"
                android:drawablePadding="8dp" />

            <TextView
                android:id="@+id/txtCantidadPagado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="S/ 0.00"
                android:textColor="@color/status_success"
                android:textSize="32sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Right Panel: Keypad -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/glVertical">

            <GridLayout
                android:id="@+id/gridLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="3"
                app:layout_constraintBottom_toTopOf="@+id/llActions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <Button android:id="@+id/btnNumber1" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="1" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber2" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="2" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber3" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="3" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber4" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="4" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber5" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="5" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber6" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="6" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber7" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="7" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber8" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="8" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumber9" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="9" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <Button android:id="@+id/btnNumberCancel" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="C" app:backgroundTint="@color/status_error" android:textColor="@color/white" />
                <Button android:id="@+id/btnNumber0" style="@style/AppTheme.Button.Modern" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:text="0" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
                <ImageButton android:id="@+id/btnNumberDelete" style="@style/AppTheme.Button.Icon" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:src="@drawable/backspace" app:tint="@color/gray_700" />
            </GridLayout>

            <LinearLayout
                android:id="@+id/llActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent">

                <Button
                    android:id="@+id/btnCancelar"
                    style="@style/AppTheme.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Salir" />

                <Button
                    android:id="@+id/btnGuardar"
                    style="@style/AppTheme.Button.Modern"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Cobrar" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
