<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppTheme.Card.Modern"
    android:id="@+id/cvAdditionalPrice"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@color/gray_100"
            android:gravity="center"
            android:text="Precio"
            android:textColor="@color/gray_600"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtAdditionalPrice"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="S/ 0.00"
            android:textColor="@color/gray_900"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/imgbtnDeletePriceAdditional"
            style="@style/AppTheme.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/status_error"
            app:srcCompat="@drawable/ic_delete_white_24dp"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Legacy Compatibility IDs -->
    <View android:id="@+id/RLTextoTituloPrecio" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/RLTextoPrecio" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</com.google.android.material.card.MaterialCardView>
