<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app">

    <com.google.android.material.card.MaterialCardView
        style="@style/AppTheme.Card.Modern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                style="@style/AppTheme.Button.Icon"
                app:srcCompat="@drawable/arrow_back_simple"
                app:tint="@color/gray_600" />

            <EditText
                style="@style/AppTheme.EditText.Modern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Buscar Categoría..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp" />

            <ImageButton
                android:layout_width="48dp"
                android:layout_height="48dp"
                style="@style/AppTheme.Button.Icon"
                app:srcCompat="@drawable/search"
                app:tint="@color/colorPrimary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Generic Button from original layout (kept for ID/Logic if any, but hidden if not needed) -->
    <Button
        android:id="@+id/btnLegacy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
