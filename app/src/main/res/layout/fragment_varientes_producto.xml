<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:sothree="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Fragment.VariantesProducto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.wang.avi.AVLoadingIndicatorView
            android:id="@+id/pbIndicator"
            style="@style/AVLoadingIndicatorView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:indicatorColor="@color/colorAccent"
            app:indicatorName="BallPulseIndicator" />

        <TextView
            android:id="@+id/txtCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pbIndicator"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="Cargando información"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.sothree.slidinguppanel.SlidingUpPanelLayout
            android:id="@+id/sliding_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            sothree:umanoClipPanel="false"
            sothree:umanoOverlay="true"
            sothree:umanoPanelHeight="0dp"
            sothree:umanoScrollableView="@+id/rvVariantesEditable"
            sothree:umanoShadowHeight="0dp">

            <!-- MAIN CONTENT -->
            <RelativeLayout
                android:id="@+id/contentVariantes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/contenedorPrimario"
                    style="@style/AppTheme.Card.Modern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:id="@+id/contentButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnAgregarOpcion"
                                style="@style/AppTheme.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agregar Opción"
                                android:visibility="gone"
                                app:icon="@drawable/plus" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/sActivarVariantes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="Habilitar Variantes"
                                android:textColor="@color/gray_700"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnHabilitaVariante"
                                style="@style/AppTheme.Button.Modern"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Habilitar Edición"
                                android:visibility="gone" />
                        </RelativeLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvOpcionesVariantes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <RelativeLayout
                    android:id="@+id/contenedorSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/contenedorPrimario"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:id="@+id/headerActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnGenerarVariantes"
                            style="@style/AppTheme.Button.Modern"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Generar Variantes" />

                        <Button
                            android:id="@+id/btnEdicionVariantes"
                            style="@style/AppTheme.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Configurar"
                            app:icon="@drawable/settings" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/AppTheme.Card.Modern"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@id/headerActions"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/gray_100"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/txtTituloVariante"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Variante"
                                    android:textColor="@color/gray_700"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="60dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="P.Comp"
                                        android:textColor="@color/gray_600"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/textView7"
                                        android:layout_width="60dp"
                                        android:layout_height="wrap_content"
                                        android:gravity="center"
                                        android:text="P.Venta"
                                        android:textColor="@color/gray_600"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </RelativeLayout>

                            <!-- Legacy divider hidden -->
                            <View android:id="@+id/linearLayout5" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvVariantes"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>
            </RelativeLayout>

            <!-- SLIDING PANEL (EDITION) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/AppTheme.Card.Modern"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardElevation="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <ImageButton
                        android:id="@+id/btnArrow"
                        style="@style/AppTheme.Button.Icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:srcCompat="@drawable/arrowdisplay"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:id="@+id/txtNumVariantes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="12dp"
                        android:text="0 Variantes"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/panelActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEliminarVariante"
                            style="@style/AppTheme.Button.Icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:icon="@drawable/ic_delete_white_24dp"
                            app:iconTint="@color/status_error" />

                        <Button
                            android:id="@+id/btnEditarVariante"
                            style="@style/AppTheme.Button.Icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            app:icon="@drawable/settings"
                            app:iconTint="@color/colorPrimary" />
                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/panelHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/btnArrow"
                        android:layout_marginTop="16dp"
                        android:background="@color/gray_100"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/textView11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Descripción"
                            android:textColor="@color/gray_700"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/edtStock"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Stock"
                                android:textColor="@color/gray_600"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtPCompra"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="P.Comp"
                                android:textColor="@color/gray_600"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtPVenta"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="P.Venta"
                                android:textColor="@color/gray_600"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvVariantesEditable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@id/panelHeader"
                        android:layout_marginTop="8dp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

        </com.sothree.slidinguppanel.SlidingUpPanelLayout>
    </RelativeLayout>
</FrameLayout>
