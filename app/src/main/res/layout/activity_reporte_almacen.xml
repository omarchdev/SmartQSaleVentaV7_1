<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context=".Activitys.ReporteAlmacen">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSelection"
        style="@style/AppTheme.Card.Modern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <RadioGroup
            android:id="@+id/rgAlmacen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Selección de Almacenes"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todos los almacenes" />

            <RadioButton
                android:id="@+id/rbUno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Almacén específico" />
        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSpinner"
        style="@style/AppTheme.Card.Modern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardSelection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Seleccionar Almacén"
                android:textColor="@color/gray_600"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spnAlmacenes"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnGReporte"
        style="@style/AppTheme.Button.Modern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="GENERAR REPORTE"
        app:layout_constraintTop_toBottomOf="@+id/cardSpinner" />

    <!-- Legacy ID compatibility -->
    <View android:id="@+id/relativeLayout11" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <View android:id="@+id/rspn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
