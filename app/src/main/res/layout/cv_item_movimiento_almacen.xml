<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppTheme.Card.Modern"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtNumeroMovimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Movimiento #0"
            android:textColor="@color/gray_900"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTipoMov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/gray_200"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="ENTRADA"
            android:textColor="@color/gray_700"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/txtNumeroMovimiento"
            app:layout_constraintEnd_toStartOf="@+id/btnOption"
            app:layout_constraintTop_toTopOf="@+id/txtNumeroMovimiento" />

        <TextView
            android:id="@+id/txtDescripcionMovimiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Descripción del movimiento"
            android:textColor="@color/gray_700"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@+id/btnOption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtNumeroMovimiento" />

        <TextView
            android:id="@+id/txtAlmacenes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Almacén: Principal"
            android:textColor="@color/gray_600"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/btnOption"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtDescripcionMovimiento" />

        <TextView
            android:id="@+id/txtFechaMov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fecha: 01/01/2024"
            android:textColor="@color/gray_500"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtAlmacenes" />

        <ImageButton
            android:id="@+id/btnOption"
            style="@style/AppTheme.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#8942;"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_dots_vertical_white_24dp"
            app:tint="@color/gray_700" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
