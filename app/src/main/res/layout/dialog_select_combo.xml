<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtTituloCombo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray_100"
        android:padding="16dp"
        android:text="Configurar Combo"
        android:textColor="@color/gray_900"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="450dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtEligeCantidad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cantidad del Combo:"
                    android:textColor="@color/gray_700" />

                <!-- Placeholder for ClickNumberPickerView -->
                <View
                    android:id="@+id/clickNumberPickerView"
                    android:layout_width="120dp"
                    android:layout_height="40dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Seleccione los componentes:"
                android:textColor="@color/gray_900"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rlComboPack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.wang.avi.AVLoadingIndicatorView
                android:id="@+id/pbIndicator"
                style="@style/AVLoadingIndicatorView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                app:indicatorColor="@color/colorPrimary"
                app:indicatorName="BallPulseIndicator" />

            <TextView
                android:id="@+id/txtCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Cargando componentes..."
                android:textColor="@color/gray_600"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
