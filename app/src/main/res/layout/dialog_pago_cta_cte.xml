<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppTheme.Card.Modern"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtTipodePago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor Recibido"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtValorOriginal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtTipodePago"
                android:layout_marginTop="8dp"
                android:text="S/0.00"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:padding="16dp">

            <Button android:id="@+id/btnNumber1" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="1" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
            <Button android:id="@+id/btnNumber2" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="2" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
            <Button android:id="@+id/btnNumber3" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="3" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />

            <Button android:id="@+id/btnNumber4" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="4" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
            <Button android:id="@+id/btnNumber5" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="5" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
            <Button android:id="@+id/btnNumber6" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="6" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />

            <Button android:id="@+id/btnNumber7" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="7" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
            <Button android:id="@+id/btnNumber8" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="8" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
            <Button android:id="@+id/btnNumber9" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="9" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />

            <Button android:id="@+id/btnNumberCancel" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="C" android:textSize="24sp" app:backgroundTint="@color/status_error" android:textColor="@color/white" />
            <Button android:id="@+id/btnNumber0" style="@style/AppTheme.Button.Modern" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:text="0" android:textSize="24sp" app:backgroundTint="@color/gray_100" android:textColor="@color/gray_900" />
            <ImageButton android:id="@+id/btnNumberDelete" style="@style/AppTheme.Button.Icon" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:src="@drawable/backspace" app:tint="@color/gray_700" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <Button
                android:id="@+id/btnCancelar"
                style="@style/AppTheme.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancelar" />

            <Button
                android:id="@+id/btnGuardar"
                style="@style/AppTheme.Button.Modern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Confirmar" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
