<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        style="@style/AppTheme.Card.Modern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/imgArrowBack"
                style="@style/AppTheme.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:srcCompat="@drawable/arrow_back_grid"
                app:tint="@color/gray_700" />

            <androidx.appcompat.widget.SearchView
                android:id="@+id/svVendedor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edittext_modern"
                android:backgroundTint="@color/white"
                app:iconifiedByDefault="false"
                app:queryHint="Buscar Vendedor..." />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVendedoresParaVenta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/llActions"
        app:layout_constraintTop_toBottomOf="@+id/cardSearch" />

    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnEliminarVendedor"
            style="@style/AppTheme.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quitar Vendedor"
            android:textColor="@color/status_error"
            app:strokeColor="@color/status_error" />

        <Button
            android:id="@+id/btnAgregarVendedor"
            style="@style/AppTheme.Button.Modern"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Nuevo"
            android:visibility="gone"
            app:icon="@drawable/plus" />
    </LinearLayout>

    <!-- Compatibility IDs -->
    <EditText android:id="@+id/edtBusquedaVendedor" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ListView android:id="@+id/listViewVendedoresEnVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
