<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvCabeceraVenta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:elevation="4dp"
    android:background="@color/background_card">

    <LinearLayout
        android:padding="12dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout

            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtDescripcionDoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="descripcionDoc"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEstadoCpe"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxWidth="150dip"
                android:text="TextView"
                android:textAlignment="textEnd" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView

                android:id="@+id/txtTituloVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Venta"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtFechaVenta"
                android:layout_width="0dp"
                android:textAlignment="textEnd"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="31/12/2017 11:57" />


        </LinearLayout>

        <LinearLayout
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtTituloVenta"
                android:text="Cliente"
                />
            <TextView
                android:id="@+id/txtDatoCliente"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="52dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtFechaVenta"
                android:layout_alignRight="@id/txtCliente"
                android:layout_alignParentRight="true"
                android:text="Cliente no especificado"
                android:textAlignment="textEnd" />
        </LinearLayout>

        <LinearLayout
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtVendedor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtCliente"
                android:text="Vendedor"
                />
            <TextView
                android:id="@+id/txtDatoVendedor"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textAlignment="textEnd"
                android:layout_height="wrap_content"
                 android:text="Vendedor no especificado" />

        </LinearLayout>

        <LinearLayout
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/txtValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtVendedor"
                android:text="Valor"
                />




            <TextView
                android:id="@+id/txtDatoValorVenta"

                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textAlignment="textEnd"
                android:layout_below="@id/txtDatoVendedor"
                android:layout_alignRight="@id/txtValor"
                android:layout_alignParentRight="true"
                android:text="S/1000.00"
                />


        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/txtEstadoVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txtValor"
                android:text="@string/estado_venta_cancelar"
                android:textColor="#ff3434"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>



</androidx.cardview.widget.CardView>