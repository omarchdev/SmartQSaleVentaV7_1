<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch"
        style="@style/AppTheme.Card.Modern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtCodigoBarra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Código de Barras"
                android:textColor="@color/gray_700"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbCargar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/txtCodigoBarra"
                android:visibility="gone" />

            <!-- Invisible focus catcher for scanner -->
            <EditText
                android:id="@+id/edtBarCode"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:inputType="none" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/btnSalir"
        app:layout_constraintTop_toBottomOf="@+id/cardSearch" />

    <Button
        android:id="@+id/btnSalir"
        style="@style/AppTheme.Button.Modern"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Cerrar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Legacy ID compatibility -->
    <View android:id="@+id/contentData" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
