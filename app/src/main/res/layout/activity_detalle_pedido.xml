<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    android:fitsSystemWindows="true"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Activitys.DetallePedido">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/AppTheme.Toolbar.Modern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="@drawable/arrow_back_home"
            app:navigationIconTint="@color/black">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Detalle del Pedido"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="18sp" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ProgressBar
            android:id="@+id/pbPedido"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:elevation="10dp" />

        <com.sothree.slidinguppanel.SlidingUpPanelLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/backgroud_app"
            android:gravity="bottom"
            app:umanoPanelHeight="1dp"
            app:umanoShadowHeight="0dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/llContentPedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="100dp">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/AppTheme.Card.Modern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_marginBottom="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/txtFechaPedido"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FechaPedido"
                                android:textColor="@color/gray_600"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtNumPedido"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="NumPedido"
                                android:textColor="@color/colorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtNombreVendedor"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/txtFechaPedido"
                                android:layout_marginTop="16dp"
                                android:drawablePadding="12dp"
                                android:drawableStart="@drawable/ic_account_circle_white_24dp"
                                android:text="Vendedor no especificado"
                                android:textColor="@color/gray_700"
                                android:textSize="14sp"
                                android:drawableTint="@color/gray_700" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/txtNombreCliente"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/txtNombreVendedor"
                                android:layout_marginTop="8dp"
                                android:drawablePadding="12dp"
                                android:drawableStart="@drawable/ic_human_male_female_white_24dp"
                                android:text="Cliente no especificado"
                                android:textColor="@color/gray_900"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:drawableTint="@color/gray_700" />

                            <TextView
                                android:id="@+id/txtZonaServicio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/txtNombreCliente"
                                android:layout_marginTop="12dp"
                                android:gravity="end"
                                android:text="Zona de servicio"
                                android:textColor="@color/gray_600"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtDocPago"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/txtZonaServicio"
                                android:layout_marginTop="4dp"
                                android:gravity="end"
                                android:text="Documento de pago"
                                android:textColor="@color/status_success"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/AppTheme.Card.Modern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="Resumen del Pedido"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/txtValorBruto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Valor bruto"
                                    android:textColor="@color/gray_700" />

                                <TextView
                                    android:id="@+id/txtValorBrutoDato"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="S/0.00"
                                    android:textColor="@color/gray_900" />

                                <TextView
                                    android:id="@+id/txtValorDescuento"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/txtValorBruto"
                                    android:layout_marginTop="8dp"
                                    android:text="Descuento"
                                    android:textColor="@color/gray_700" />

                                <TextView
                                    android:id="@+id/valorDescuentoDato"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_below="@id/txtValorBrutoDato"
                                    android:layout_marginTop="8dp"
                                    android:text="S/0.00"
                                    android:textColor="@color/status_error" />

                                <View
                                    android:id="@+id/divider1"
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_below="@id/txtValorDescuento"
                                    android:layout_marginTop="12dp"
                                    android:background="@color/gray_200" />

                                <TextView
                                    android:id="@+id/txtValorNeto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/divider1"
                                    android:layout_marginTop="12dp"
                                    android:text="TOTAL"
                                    android:textColor="@color/gray_900"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtValorNetoDato"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_below="@id/divider1"
                                    android:layout_marginTop="12dp"
                                    android:text="S/0.00"
                                    android:textColor="@color/status_success"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvEntrega"
                        style="@style/AppTheme.Card.Modern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="Estado de Entrega"
                                android:textColor="@color/colorPrimary"
                                android:textStyle="bold" />

                            <RelativeLayout
                                android:id="@+id/rlFechaEntrega"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fecha Programada"
                                    android:textColor="@color/gray_700" />

                                <TextView
                                    android:id="@+id/txtFechaEntrega"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="Fecha Entrega"
                                    android:textColor="@color/gray_900"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <LinearLayout
                                android:id="@+id/rlEstadoEntrega"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <RadioGroup
                                    android:id="@+id/rgEntregado"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/rb1"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Entregado" />

                                    <RadioButton
                                        android:id="@+id/rb2"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Pendiente" />
                                </RadioGroup>

                                <Button
                                    android:id="@+id/btnEstadoEntrega"
                                    style="@style/AppTheme.Button.Modern"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="Actualizar Entrega" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="8dp"
                        android:text="Artículos del Pedido"
                        android:textColor="@color/gray_700"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDetallePedido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="8dp"
                        android:text="Métodos de Pago"
                        android:textColor="@color/gray_700"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMetodosDePago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/AppTheme.Card.Modern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_small">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Observaciones"
                                android:textColor="@color/gray_600"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtObservaciones"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/gray_900"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Keeping original containers for compatibility but hidden -->
                    <LinearLayout
                        android:id="@+id/content_datos_entrega"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtNroCelular"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtDireccionEntrega"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView android:id="@+id/txtTiempoEntrega" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtEstadoActual" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtClienteEntrega" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtMetodoPagoEntrega" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtEmailEntrega" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtTipoEntrega" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtNroPedido" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                    <TextView android:id="@+id/txtFechaCreacion" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                    <Button
                        android:id="@+id/btnEstadoPago"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                </LinearLayout>
            </ScrollView>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <FrameLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </RelativeLayout>

        </com.sothree.slidinguppanel.SlidingUpPanelLayout>

        <com.getbase.floatingactionbutton.FloatingActionsMenu
            android:id="@+id/floating_button_pedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            app:fab_addButtonColorNormal="@color/colorPrimaryDark"
            app:fab_labelStyle="@style/LabelFloatingButton"
            app:fab_labelsPosition="left">

            <com.getbase.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAdelanto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fab_colorNormal="#28aef1"
                app:fab_icon="@drawable/ic_receipt_white_24dp"
                app:fab_size="mini"
                app:fab_title="Adelantos" />

            <com.getbase.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabImprimirVenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fab_colorNormal="#28aef1"
                app:fab_icon="@drawable/ic_receipt_white_24dp"
                app:fab_size="mini"
                app:fab_title="Imprimir" />

        </com.getbase.floatingactionbutton.FloatingActionsMenu>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
