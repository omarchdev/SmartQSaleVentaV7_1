<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_ventas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Fragment.VentasFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rVentas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <EditText
                android:id="@+id/edtCodigoBarra"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="Hola"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/linearLayoutButtonSales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top Actions: Vendedor, Lock, Cliente -->
                <LinearLayout
                    style="@style/AppTheme.Sales.ActionBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnElegirVendedor"
                        style="@style/AppTheme.Sales.ActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vendedor"
                        app:icon="@drawable/ic_account_plus_white_24dp" />

                    <ImageButton
                        android:id="@+id/imgLock"
                        style="@style/AppTheme.Button.Icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="8dp"
                        app:srcCompat="@drawable/ic_lock_open_variant_white_24dp"
                        app:tint="@color/gray_600" />

                    <Button
                        android:id="@+id/btnElegirCliente"
                        style="@style/AppTheme.Sales.ActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cliente"
                        app:icon="@drawable/ic_human_male_female_white_24dp" />

                    <Button
                        android:id="@+id/btnZonaServicio"
                        style="@style/AppTheme.Sales.ActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnModoVenta"
                        style="@style/AppTheme.Sales.ActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Cart Summary & Checkout -->
                <LinearLayout
                    style="@style/AppTheme.Sales.CartSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/linearLayoutBtnDetalleVenta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/layoutInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtCantidadProducto"
                                style="@style/AppTheme.Sales.QuantityBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawablePadding="4dp"
                                android:text="x0"
                                app:drawableStartCompat="@drawable/car_sale"
                                app:drawableTint="@color/colorPrimary" />

                            <LinearLayout
                                android:id="@+id/content_Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtNombreUltimoProductoEnCarrito"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Detalle de venta"
                                    android:textColor="@color/gray_900"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtPrecioUltimoProductoEnCarrito"
                                    style="@style/AppTheme.Sales.PriceText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Presiona aquí" />

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnCobrar"
                        style="@style/AppTheme.Sales.CheckoutButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Cobrar\nS/0.00" />

                </LinearLayout>

                <!-- Indicator/Toggle Visual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/imgArrowDisplay"
                        style="@style/AppTheme.Button.Icon"
                        android:layout_width="48dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/arrowdisplay"
                        app:tint="@color/gray_400" />
                </LinearLayout>

                <!-- Main Content Area -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.sothree.slidinguppanel.SlidingUpPanelLayout
                        android:id="@+id/sliding_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top"
                        app:umanoClipPanel="true"
                        app:umanoDragView="@+id/linearContenedorVenta"
                        app:umanoOverlay="true"
                        app:umanoPanelHeight="1dp"
                        app:umanoScrollableView="@id/rvCarritoVenta"
                        app:umanoShadowHeight="6dp">

                        <!-- Main Screen Content (Products or Vehicle) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <!-- NORMAL SALES CONTENT -->
                            <RelativeLayout
                                android:id="@+id/content_venta1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="visible">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical">

                                    <!-- Search and Filters Bar -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:padding="@dimen/spacing_small">

                                        <ImageButton
                                            android:id="@+id/imgBackGrid"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            app:srcCompat="@drawable/arrow_back_grid" />

                                        <ImageButton
                                            android:id="@+id/imgTipoVistaLista"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            app:srcCompat="@drawable/grid" />

                                        <ImageButton
                                            android:id="@+id/imgBtnScan"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="40dp"
                                            android:layout_height="40dp"
                                            app:srcCompat="@drawable/ic_barcode_scan_white_24dp" />

                                        <androidx.appcompat.widget.SearchView
                                            android:id="@+id/edtSearchProduct"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:layout_weight="1"
                                            android:background="@drawable/bg_edittext_modern"
                                            android:backgroundTint="@color/white"
                                            app:iconifiedByDefault="false"
                                            app:queryHint="Buscar producto..." />

                                    </LinearLayout>

                                    <!-- Product List/Grid Area -->
                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1">

                                        <RelativeLayout
                                            android:id="@+id/layoutContnedorProductos"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent">


                                            <!-- Legacy views hidden -->
                                            <GridView
                                                android:id="@+id/gv_Categorias"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_below="@id/spinnerCategoria"
                                                android:clipToPadding="false"
                                                android:horizontalSpacing="8dp"
                                                android:numColumns="@integer/NumColumnVentas"
                                                android:padding="8dp"
                                                android:verticalSpacing="8dp"
                                                android:visibility="gone" />

                                            <GridView
                                                android:id="@+id/gv_articulosVenta"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_below="@id/spinnerCategoria"
                                                android:clipToPadding="false"
                                                android:columnWidth="100dp"
                                                android:numColumns="auto_fit"
                                                android:padding="8dp"
                                                android:verticalSpacing="8dp"
                                                android:visibility="gone" />

                                            <ProgressBar
                                                android:id="@+id/pbPedido"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerInParent="true"
                                                android:visibility="gone" />

                                            <Spinner
                                                android:id="@+id/spinnerCategoria"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@color/white"
                                                android:padding="8dp"
                                                android:visibility="gone" />

                                            <TextView
                                                android:id="@+id/txtTextoCarrito"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:gravity="center"
                                                android:padding="32dp"
                                                android:text="No hay productos en el Inventario"
                                                android:textColor="@color/gray_500"
                                                android:textSize="20sp"
                                                android:textStyle="bold"
                                                android:visibility="gone"
                                                app:drawableTopCompat="@drawable/inventory" />

                                            <androidx.recyclerview.widget.RecyclerView
                                                android:id="@+id/rvProductsInSale"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_below="@id/spinnerCategoria"
                                                android:clipToPadding="false"
                                                android:padding="8dp"
                                                android:visibility="visible" />

                                            <androidx.recyclerview.widget.RecyclerView
                                                android:id="@+id/rvGridarticulosVenta"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:clipToPadding="false"
                                                android:padding="8dp"
                                                android:visibility="gone" />
                                        </RelativeLayout>

                                        <View
                                            android:id="@+id/background_dimmer"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="#40000000"
                                            android:elevation="4dp"
                                            android:visibility="gone" />

                                        <com.wang.avi.AVLoadingIndicatorView
                                            android:id="@+id/avi"
                                            style="@style/AVLoadingIndicatorView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            app:indicatorColor="@color/colorPrimary"
                                            app:indicatorName="BallScaleMultipleIndicator" />
                                    </FrameLayout>

                                </LinearLayout>
                            </RelativeLayout>

                            <!-- VEHICLE / SERVICE MODE CONTENT -->
                            <RelativeLayout
                                android:id="@+id/content_venta2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone">

                                <ScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:clipToPadding="false"
                                    android:padding="@dimen/spacing_medium">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <!-- Header Stats (Aforo / Clock) -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center"
                                            android:orientation="horizontal">

                                            <com.google.android.material.card.MaterialCardView
                                                android:id="@+id/content_aforo"
                                                style="@style/AppTheme.Sales.AforoCard">

                                                <LinearLayout
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:gravity="center"
                                                    android:orientation="vertical"
                                                    android:padding="12dp">

                                                    <TextView
                                                        android:id="@+id/txtAforoLibre"
                                                        style="@style/AppTheme.Sales.AforoText"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="0" />

                                                    <TextView
                                                        style="@style/AppTheme.Sales.AforoLabel"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="Espacios" />
                                                </LinearLayout>
                                            </com.google.android.material.card.MaterialCardView>

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="16dp"
                                                android:orientation="vertical">

                                                <TextClock
                                                    android:id="@+id/textClock"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:format12Hour="hh:mm:ss a"
                                                    android:textColor="@color/gray_900"
                                                    android:textSize="24sp"
                                                    android:textStyle="bold" />

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Hora del dispositivo"
                                                    android:textColor="@color/gray_600"
                                                    android:textSize="12sp" />
                                            </LinearLayout>
                                        </LinearLayout>

                                        <!-- Plate Input Area -->
                                        <com.google.android.material.card.MaterialCardView
                                            style="@style/AppTheme.Card.Modern"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="24dp">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal"
                                                android:padding="16dp">

                                                <LinearLayout
                                                    android:layout_width="0dp"
                                                    android:layout_height="wrap_content"
                                                    android:layout_weight="1"
                                                    android:orientation="vertical">

                                                    <TextView
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="PLACA"
                                                        android:textColor="@color/gray_600"
                                                        android:textSize="10sp"
                                                        android:textStyle="bold" />

                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:gravity="center_vertical"
                                                        android:orientation="horizontal">

                                                        <ImageButton
                                                            android:id="@+id/btnScanPlaca"
                                                            style="@style/AppTheme.Button.Icon"
                                                            android:layout_width="40dp"
                                                            android:layout_height="40dp"
                                                            app:srcCompat="@drawable/ic_barcode_scan_white_36dp"
                                                            app:tint="@color/colorPrimary" />

                                                        <EditText
                                                            android:id="@+id/edtPlaca"
                                                            style="@style/AppTheme.Sales.PlateInput"
                                                            android:layout_width="match_parent"
                                                            android:layout_height="wrap_content"
                                                            android:hint="ABC-123" />
                                                    </LinearLayout>
                                                </LinearLayout>

                                                <ImageView
                                                    android:id="@+id/imgTipoLista"
                                                    android:layout_width="64dp"
                                                    android:layout_height="64dp"
                                                    android:layout_marginStart="16dp"
                                                    android:padding="8dp"
                                                    android:background="@drawable/bg_edittext_modern"
                                                    android:backgroundTint="@color/gray_100"
                                                    app:srcCompat="@drawable/ic_folder_open_outline_grey600_48dp" />
                                            </LinearLayout>
                                        </com.google.android.material.card.MaterialCardView>

                                        <!-- Mode Actions -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="24dp"
                                            android:orientation="horizontal">

                                            <Button
                                                android:id="@+id/btnTipoLista"
                                                style="@style/AppTheme.Button.Modern"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_weight="2"
                                                android:text="PROCESAR" />

                                            <Button
                                                android:id="@+id/btnHabMod"
                                                style="@style/AppTheme.Button.Outlined"
                                                android:layout_width="0dp"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="8dp"
                                                android:layout_weight="2"
                                                android:text="EDITAR" />

                                            <ImageButton
                                                android:id="@+id/btnLimpiar"
                                                style="@style/AppTheme.Button.Icon"
                                                android:layout_width="48dp"
                                                android:layout_height="48dp"
                                                android:layout_marginStart="8dp"
                                                android:background="@drawable/bg_edittext_modern"
                                                android:backgroundTint="@color/gray_200"
                                                app:srcCompat="@drawable/ic_broom_white_36dp"
                                                app:tint="@color/gray_700" />
                                        </LinearLayout>

                                        <!-- Time & Status -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="32dp"
                                            android:orientation="vertical">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal"
                                                android:paddingBottom="16dp">

                                                <TextView
                                                    android:layout_width="80dp"
                                                    android:layout_height="wrap_content"
                                                    android:text="INGRESO"
                                                    android:textColor="@color/gray_600"
                                                    android:textSize="12sp"
                                                    android:textStyle="bold" />

                                                <EditText
                                                    android:id="@+id/edtHoraIngreso"
                                                    style="@style/AppTheme.EditText.Modern"
                                                    android:layout_width="0dp"
                                                    android:layout_height="wrap_content"
                                                    android:layout_weight="1"
                                                    android:enabled="false" />

                                                <ImageButton
                                                    android:id="@+id/btnHoraInit"
                                                    style="@style/AppTheme.Button.Icon"
                                                    android:layout_width="40dp"
                                                    android:layout_height="40dp"
                                                    app:srcCompat="@drawable/ic_calendar_clock_white_24dp"
                                                    app:tint="@color/colorPrimary" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal"
                                                android:paddingBottom="16dp">

                                                <TextView
                                                    android:layout_width="80dp"
                                                    android:layout_height="wrap_content"
                                                    android:text="SALIDA"
                                                    android:textColor="@color/gray_600"
                                                    android:textSize="12sp"
                                                    android:textStyle="bold" />

                                                <EditText
                                                    android:id="@+id/edtHoraSalida"
                                                    style="@style/AppTheme.EditText.Modern"
                                                    android:layout_width="0dp"
                                                    android:layout_height="wrap_content"
                                                    android:layout_weight="1"
                                                    android:enabled="false" />

                                                <ImageButton
                                                    android:id="@+id/btnHoraFin"
                                                    style="@style/AppTheme.Button.Icon"
                                                    android:layout_width="40dp"
                                                    android:layout_height="40dp"
                                                    app:srcCompat="@drawable/ic_calendar_clock_white_24dp"
                                                    app:tint="@color/colorPrimary" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal"
                                                android:paddingBottom="16dp">

                                                <TextView
                                                    android:layout_width="80dp"
                                                    android:layout_height="wrap_content"
                                                    android:text="TIEMPO"
                                                    android:textColor="@color/gray_600"
                                                    android:textSize="12sp"
                                                    android:textStyle="bold" />

                                                <EditText
                                                    android:id="@+id/edtTiempoTranscurrido"
                                                    style="@style/AppTheme.EditText.Modern"
                                                    android:layout_width="0dp"
                                                    android:layout_height="wrap_content"
                                                    android:layout_weight="1"
                                                    android:enabled="false" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal">

                                                <TextView
                                                    android:layout_width="80dp"
                                                    android:layout_height="wrap_content"
                                                    android:text="ETAPAS"
                                                    android:textColor="@color/gray_600"
                                                    android:textSize="12sp"
                                                    android:textStyle="bold" />

                                                <EditText
                                                    android:id="@+id/edtEtapaCont"
                                                    style="@style/AppTheme.EditText.Modern"
                                                    android:layout_width="0dp"
                                                    android:layout_height="wrap_content"
                                                    android:layout_weight="1"
                                                    android:enabled="false" />
                                            </LinearLayout>
                                        </LinearLayout>

                                        <!-- Status Indicator -->
                                        <TextView
                                            android:id="@+id/txtEstadoPermitir"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="48dp"
                                            android:gravity="center"
                                            android:text="ENTRA"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="32sp"
                                            android:textStyle="bold" />

                                        <!-- Optional IDs kept -->
                                        <EditText android:id="@+id/edtEspaciosLibres" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtObservacion" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                                    </LinearLayout>
                                </ScrollView>

                            </RelativeLayout>
                        </LinearLayout>

                        <!-- Pull-up Content: Cart Details -->
                        <RelativeLayout
                            android:id="@+id/linearContenedorVenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:elevation="8dp">

                            <!-- Drag Handle -->
                            <View
                                android:layout_width="40dp"
                                android:layout_height="4dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="8dp"
                                android:background="@color/gray_300" />

                            <!-- Cart Actions Bar -->
                            <LinearLayout
                                android:id="@+id/contentButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/rvCarritoVenta"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <Button
                                    android:id="@+id/btnCancelarVenta"
                                    style="@style/AppTheme.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="ANULAR"
                                    android:textColor="@color/status_error"
                                    app:strokeColor="@color/status_error" />

                                <ImageButton
                                    android:id="@+id/btnOpenGuardarPedido"
                                    style="@style/AppTheme.Button.Icon"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_marginHorizontal="12dp"
                                    android:background="@drawable/bg_edittext_modern"
                                    android:backgroundTint="@color/gray_100"
                                    app:srcCompat="@drawable/save_white"
                                    app:tint="@color/colorPrimary" />

                                <TextView
                                    android:id="@+id/txtDescuentoPrecioVenta"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end|center_vertical"
                                    android:text="S/ 0.00"
                                    android:textColor="@color/status_success"
                                    android:textStyle="bold"
                                    app:drawableStartCompat="@drawable/percent1"
                                    android:drawablePadding="8dp" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvCarritoVenta"
                                android:layout_width="match_parent"
                                android:layout_height="300dp"
