<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppTheme.Card.Modern"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="600dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Configurar Impresora"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbNinguno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin Impresora" />

                <RadioButton
                    android:id="@+id/rbBluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth" />

                <RadioButton
                    android:id="@+id/rbPdfRed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Red (Ethernet/WiFi)" />

                <RadioButton
                    android:id="@+id/rbUsb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="USB" />

                <RadioButton
                    android:id="@+id/rbPdfPrinter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:visibility="gone" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/llBluetoothContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSeleccionImpresora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccione un dispositivo:"
                    android:textColor="@color/gray_600"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDriversBT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/txtTextoInformacionBluetooth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No se encontraron impresoras. Verifique que el Bluetooth esté activo."
                    android:textColor="@color/status_error"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llNetworkContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTheme.TextInputLayout.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Dirección IP">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtIP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number|text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AppTheme.TextInputLayout.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Puerto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPuerto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="9100" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnTestPrinterRed"
                    style="@style/AppTheme.Button.Modern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Probar Conexión" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgAncho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/rb53mm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="53mm" />

                <RadioButton
                    android:id="@+id/rb80mm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="80mm" />
            </RadioGroup>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>
