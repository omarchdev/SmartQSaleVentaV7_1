<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context=".Fragment.EntregaPedidoDatosEntrega">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtTituloDatosEntrega"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Resumen de Entrega"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppTheme.Card.Modern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:stretchColumns="1">

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/txtEtqNroPedido" android:text="Nro Pedido" android:textColor="@color/gray_600" android:textStyle="bold" />
                        <TextView android:id="@+id/txtNroPedido" android:gravity="end" android:textColor="@color/gray_900" android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/txtEtqEstadoActual" android:text="Estado" android:textColor="@color/gray_600" android:textStyle="bold" />
                        <TextView android:id="@+id/txtEstadoActual" android:gravity="end" android:textColor="@color/colorPrimary" android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/txtEtqFechaCreacion" android:text="Creación" android:textColor="@color/gray_600" android:textStyle="bold" />
                        <TextView android:id="@+id/txtFechaCreacion" android:gravity="end" android:textColor="@color/gray_800" />
                    </TableRow>

                    <View android:layout_height="1dp" android:background="@color/gray_100" android:layout_marginBottom="12dp" />

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/txtEtqCliente" android:text="Cliente" android:textColor="@color/gray_600" android:textStyle="bold" />
                        <TextView android:id="@+id/txtCliente" android:gravity="end" android:textColor="@color/gray_900" android:textStyle="bold" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/txtEtqCelular" android:text="Celular" android:textColor="@color/gray_600" android:textStyle="bold" />
                        <TextView android:id="@+id/txtCelular" android:gravity="end" android:textColor="@color/gray_800" />
                    </TableRow>

                    <TableRow android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/txtEtqTipoEntrega" android:text="Tipo" android:textColor="@color/gray_600" android:textStyle="bold" />
                        <TextView android:id="@+id/txtTipoEntrega" android:gravity="end" android:textColor="@color/gray_800" />
                    </TableRow>

                    <TableRow>
                        <TextView android:id="@+id/txtEtqDireccion" android:text="Dirección" android:textColor="@color/gray_600" android:textStyle="bold" />
                        <TextView android:id="@+id/txtDireccion" android:gravity="end" android:textColor="@color/gray_800" />
                    </TableRow>

                </TableLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
