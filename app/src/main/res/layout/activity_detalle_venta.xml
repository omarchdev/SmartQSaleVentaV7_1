<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    android:fitsSystemWindows="true"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Activitys.DetalleVenta">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/AppTheme.Toolbar.Modern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="@drawable/arrow_back_home">

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Detalle Venta"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="18sp" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar
        android:id="@+id/pbDetalleVenta"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="10dp"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/AppTheme.Card.Modern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtFechaPedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FechaPedido"
                        android:textColor="@color/gray_600"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtEstadoVenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="EstadoVenta"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNombreCliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtFechaPedido"
                        android:layout_marginTop="16dp"
                        android:drawableStart="@drawable/ic_human_male_female_white_24dp"
                        android:drawablePadding="12dp"
                        app:drawableTint="@color/gray_700"
                        android:text="Cliente no especificado"
                        android:textColor="@color/gray_900"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNombreVendedor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtNombreCliente"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_account_circle_white_36dp"
                        android:drawablePadding="12dp"
                        app:drawableTint="@color/gray_700"
                        android:text="Vendedor no especificado"
                        android:textColor="@color/gray_700"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtNumFactura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtNombreVendedor"
                        android:layout_marginTop="8dp"
                        android:text="Número de factura"
                        android:textColor="@color/gray_600"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtEstadoDocumentoCpe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtNumFactura"
                        android:layout_marginTop="4dp"
                        android:text="TextView"
                        android:textColor="@color/status_success"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtIdentificador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtEstadoDocumentoCpe"
                        android:textColor="@color/gray_400"
                        android:textSize="10sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/AppTheme.Card.Modern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/AppTheme.SaleDetail.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Resumen de Cobro" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txtValorBruto"
                            style="@style/AppTheme.SaleDetail.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Valor bruto" />

                        <TextView
                            android:id="@+id/txtValorBrutoDato"
                            style="@style/AppTheme.SaleDetail.Data"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="S/0.00" />

                        <TextView
                            android:id="@+id/txtValorDescuento"
                            style="@style/AppTheme.SaleDetail.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/txtValorBruto"
                            android:layout_marginTop="8dp"
                            android:text="Descuento" />

                        <TextView
                            android:id="@+id/valorDescuentoDato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@id/txtValorBrutoDato"
                            android:layout_marginTop="8dp"
                            android:text="S/0.00"
                            android:textColor="@color/status_error" />

                        <View
                            android:id="@+id/divider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_below="@id/txtValorDescuento"
                            android:layout_marginTop="12dp"
                            android:background="@color/gray_200" />

                        <TextView
                            android:id="@+id/txtValorNeto"
                            style="@style/AppTheme.SaleDetail.TotalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/divider"
                            android:layout_marginTop="12dp"
                            android:text="TOTAL" />

                        <TextView
                            android:id="@+id/txtValorNetoDato"
                            style="@style/AppTheme.SaleDetail.TotalData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@id/divider"
                            android:layout_marginTop="12dp"
                            android:text="S/0.00" />

                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/AppTheme.SaleDetail.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="Artículos Vendidos" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetallePedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <TextView
                style="@style/AppTheme.SaleDetail.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="Métodos de Pago" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMetodosDePago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/AppTheme.Card.Modern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textView31"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Observación"
                        android:textColor="@color/gray_600"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtObservacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/gray_900" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vuelto"
                            android:textColor="@color/gray_700"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtValorCambio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="S/0.00"
                            android:textColor="@color/status_error"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.getbase.floatingactionbutton.FloatingActionsMenu
        android:id="@+id/floating_button_Venta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:fab_addButtonColorNormal="@color/colorPrimaryDark"
        app:fab_labelStyle="@style/LabelFloatingButton"
        app:fab_labelsPosition="left">


        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEnvioCpe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fab_colorNormal="#25D366"
            app:fab_icon="@drawable/ic_whatsapp_white_48dp"
            app:fab_size="mini"
            app:fab_title="Enviar comprobante" />

        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabImprimirVenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fab_colorNormal="@color/colorPrimary"
            app:fab_icon="@drawable/ic_receipt_white_24dp"
            app:fab_size="mini"
            app:fab_title="Imprimir" />

        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCancelarVenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fab_colorNormal="@color/status_error"
            app:fab_icon="@drawable/close_circle"
            app:fab_size="mini"
            app:fab_title="Anular venta" />
    </com.getbase.floatingactionbutton.FloatingActionsMenu>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
