<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_ventas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Fragment.VentasFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rVentas"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/linearLayoutButtonSales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top Actions (Tablet size) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/AppTheme.Card.Modern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        style="@style/AppTheme.Sales.ActionBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:elevation="0dp"
                        android:padding="8dp">

                        <Button
                            android:id="@+id/btnElegirVendedor"
                            style="@style/AppTheme.Sales.ActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Vendedor"
                            android:textSize="14sp"
                            app:icon="@drawable/ic_account_plus_white_36dp"
                            app:iconSize="32dp" />

                        <ImageButton
                            android:id="@+id/imgLock"
                            style="@style/AppTheme.Button.Icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginHorizontal="12dp"
                            app:srcCompat="@drawable/ic_lock_open_variant_white_24dp"
                            app:tint="@color/gray_600" />

                        <Button
                            android:id="@+id/btnElegirCliente"
                            style="@style/AppTheme.Sales.ActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cliente"
                            android:textSize="14sp"
                            app:icon="@drawable/ic_human_male_female_white_36dp"
                            app:iconSize="32dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cart Summary & Checkout -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/AppTheme.Card.Modern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        style="@style/AppTheme.Sales.CartSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <LinearLayout
                            android:id="@+id/linearLayoutBtnDetalleVenta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtCantidadProducto"
                                style="@style/AppTheme.Sales.QuantityBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="x0"
                                android:textSize="20sp"
                                app:drawableStartCompat="@drawable/car_sale" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtNombreUltimoProductoEnCarrito"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Detalle de Venta"
                                    android:textColor="@color/gray_900"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtPrecioUltimoProductoEnCarrito"
                                    style="@style/AppTheme.Sales.PriceText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Presiona para ver más"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnCobrar"
                            style="@style/AppTheme.Sales.CheckoutButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:minWidth="160dp"
                            android:paddingVertical="16dp"
                            android:text="COBRAR\nS/ 0.00"
                            android:textSize="18sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Main Content Toggle Visual -->
                <ImageButton
                    android:id="@+id/imgArrowDisplay"
                    style="@style/AppTheme.Button.Icon"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/arrowdisplay"
                    app:tint="@color/gray_400" />

                <!-- Main Content -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.sothree.slidinguppanel.SlidingUpPanelLayout
                        android:id="@+id/sliding_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top"
                        app:umanoClipPanel="true"
                        app:umanoDragView="@+id/linearContenedorVenta"
                        app:umanoOverlay="true"
                        app:umanoPanelHeight="1dp"
                        app:umanoScrollableView="@id/rvCarritoVenta"
                        app:umanoShadowHeight="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <!-- NORMAL SALES -->
                            <RelativeLayout
                                android:id="@+id/content_venta1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:padding="12dp">

                                        <ImageButton
                                            android:id="@+id/imgBackGrid"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            app:srcCompat="@drawable/arrow_back_grid" />

                                        <androidx.appcompat.widget.SearchView
                                            android:id="@+id/edtSearchProduct"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="16dp"
                                            android:layout_weight="1"
                                            android:background="@drawable/bg_edittext_modern"
                                            android:backgroundTint="@color/white"
                                            app:iconifiedByDefault="false"
                                            app:queryHint="Buscar producto..." />

                                        <ImageButton
                                            android:id="@+id/imgBtnScan"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            android:layout_marginStart="8dp"
                                            app:srcCompat="@drawable/ic_barcode_scan_white_24dp"
                                            app:tint="@color/status_success" />
                                    </LinearLayout>

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1">

                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/rvProductsInSale"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:clipToPadding="false"
                                            android:padding="8dp" />

                                        <com.wang.avi.AVLoadingIndicatorView
                                            android:id="@+id/avi"
                                            style="@style/AVLoadingIndicatorView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            app:indicatorColor="@color/colorPrimary"
                                            app:indicatorName="BallScaleMultipleIndicator" />
                                    </FrameLayout>
                                </LinearLayout>
                            </RelativeLayout>

                            <!-- VEHICLE / PARKING -->
                            <RelativeLayout
                                android:id="@+id/content_venta2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="visible">

                                <ScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical"
                                        android:padding="24dp">

                                        <!-- Header Stats -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center"
                                            android:orientation="horizontal">

                                            <com.google.android.material.card.MaterialCardView
                                                android:id="@+id/content_aforo"
                                                style="@style/AppTheme.Sales.AforoCard"
                                                android:layout_width="160dp">

                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:gravity="center"
                                                    android:orientation="vertical"
                                                    android:padding="24dp">

                                                    <TextView
                                                        android:id="@+id/txtAforoLibre"
                                                        style="@style/AppTheme.Sales.AforoText"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="0"
                                                        android:textSize="48sp" />

                                                    <TextView
                                                        style="@style/AppTheme.Sales.AforoLabel"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="Espacios Libres"
                                                        android:textSize="12sp" />
                                                </LinearLayout>
                                            </com.google.android.material.card.MaterialCardView>

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="32dp"
                                                android:orientation="vertical">

                                                <TextClock
                                                    android:id="@+id/textClock"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:format12Hour="hh:mm:ss a"
                                                    android:textColor="@color/gray_900"
                                                    android:textSize="32sp"
                                                    android:textStyle="bold" />

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Hora del Dispositivo"
                                                    android:textColor="@color/gray_600"
                                                    android:textSize="14sp" />
                                            </LinearLayout>
                                        </LinearLayout>

                                        <!-- Plate Input -->
                                        <com.google.android.material.card.MaterialCardView
                                            style="@style/AppTheme.Card.Modern"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="48dp">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:padding="24dp">

                                                <ImageButton
                                                    android:id="@+id/btnScanPlaca"
                                                    style="@style/AppTheme.Button.Icon"
                                                    android:layout_width="64dp"
                                                    android:layout_height="64dp"
                                                    app:srcCompat="@drawable/ic_barcode_scan_white_36dp"
                                                    app:tint="@color/colorPrimary" />

                                                <EditText
                                                    android:id="@+id/edtPlaca"
                                                    style="@style/AppTheme.Sales.PlateInput"
                                                    android:layout_width="0dp"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginStart="24dp"
                                                    android:layout_weight="1"
                                                    android:hint="ABC-123"
                                                    android:textSize="40sp" />

                                                <ImageView
                                                    android:id="@+id/imgTipoLista"
                                                    android:layout_width="80dp"
                                                    android:layout_height="80dp"
                                                    android:layout_marginStart="24dp"
                                                    android:padding="12dp"
                                                    android:background="@color/gray_100"
                                                    app:srcCompat="@drawable/ic_folder_open_outline_grey600_48dp" />
                                            </LinearLayout>
                                        </com.google.android.material.card.MaterialCardView>

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="48dp"
                                            android:orientation="horizontal">

                                            <Button
                                                android:id="@+id/btnTipoLista"
                                                style="@style/AppTheme.Button.Modern"
                                                android:layout_width="0dp"
                                                android:layout_height="72dp"
                                                android:layout_weight="2"
                                                android:text="PROCESAR"
                                                android:textSize="20sp" />

                                            <Button
                                                android:id="@+id/btnHabMod"
                                                style="@style/AppTheme.Button.Outlined"
                                                android:layout_width="0dp"
                                                android:layout_height="72dp"
                                                android:layout_marginStart="24dp"
                                                android:layout_weight="2"
                                                android:text="EDITAR"
                                                android:textSize="20sp" />

                                            <ImageButton
                                                android:id="@+id/btnLimpiar"
                                                style="@style/AppTheme.Button.Icon"
                                                android:layout_width="72dp"
                                                android:layout_height="72dp"
                                                android:layout_marginStart="24dp"
                                                android:background="@drawable/bg_edittext_modern"
                                                android:backgroundTint="@color/gray_200"
                                                app:srcCompat="@drawable/ic_broom_white_36dp"
                                                app:tint="@color/gray_700" />
                                        </LinearLayout>

                                        <TextView
                                            android:id="@+id/txtEstadoPermitir"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="64dp"
                                            android:gravity="center"
                                            android:text="ENTRA"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="80sp"
                                            android:textStyle="bold" />

                                        <!-- Hidden IDs -->
                                        <EditText android:id="@+id/edtHoraIngreso" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtHoraSalida" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtTiempoTranscurrido" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtEtapaCont" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtEspaciosLibres" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtObservacion" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <ImageButton android:id="@+id/btnHoraInit" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <ImageButton android:id="@+id/btnHoraFin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                                    </LinearLayout>
                                </ScrollView>
                            </RelativeLayout>
                        </LinearLayout>

                        <!-- Cart Pull-up Detail -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/linearContenedorVenta"
                            style="@style/AppTheme.Card.Modern"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardElevation="16dp"
                            app:cardCornerRadius="24dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="60dp"
                                    android:layout_height="4dp"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="12dp"
                                    android:background="@color/gray_300" />

                                <LinearLayout
                                    android:id="@+id/contentButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:padding="24dp">

                                    <Button
                                        android:id="@+id/btnCancelarVenta"
                                        style="@style/AppTheme.Button.Outlined"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="ANULAR"
                                        android:textColor="@color/status_error"
                                        app:strokeColor="@color/status_error" />

                                    <ImageButton
                                        android:id="@+id/btnOpenGuardarPedido"
                                        style="@style/AppTheme.Button.Icon"
                                        android:layout_width="64dp"
                                        android:layout_height="64dp"
                                        android:layout_marginHorizontal="16dp"
                                        android:background="@drawable/bg_edittext_modern"
                                        android:backgroundTint="@color/gray_100"
                                        app:srcCompat="@drawable/save_white"
                                        app:tint="@color/colorPrimary" />

                                    <TextView
                                        android:id="@+id/txtDescuentoPrecioVenta"
                                        style="@style/AppTheme.Sales.PriceText"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.5"
                                        android:gravity="end|center_vertical"
                                        android:text="S/ 0.00"
                                        android:textSize="24sp"
                                        app:drawableStartCompat="@drawable/percent1"
                                        android:drawablePadding="12dp" />
                                </LinearLayout>

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rvCarritoVenta"
                                    android:layout_width="match_parent"
                                    android:layout_height="450dp"
                                    android:clipToPadding="false"
                                    android:paddingBottom="16dp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </com.sothree.slidinguppanel.SlidingUpPanelLayout>
                </FrameLayout>

                <!-- Hidden legacy buttons -->
                <Button android:id="@+id/btnZonaServicio" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <Button android:id="@+id/btnModoVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <EditText android:id="@+id/edtCodigoBarra" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <ImageButton android:id="@+id/imgTipoVistaLista" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <Spinner android:id="@+id/spinnerCategoria" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvGridarticulosVenta" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/txtTextoCarrito" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <ProgressBar android:id="@+id/pbPedido" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

            </LinearLayout>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
