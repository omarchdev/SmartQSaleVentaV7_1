<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_ventas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroud_app"
    tools:context="com.omarchdev.smartqsale.smartqsaleventas.Fragment.VentasFragment">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rVentas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <EditText
                android:id="@+id/edtCodigoBarra"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:text="Hola"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/linearLayoutButtonSales"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Top Actions (Tablet size) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:elevation="@dimen/elevation_low"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_medium">

                    <Button
                        android:id="@+id/btnElegirVendedor"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableLeft="@drawable/ic_account_plus_white_36dp"
                        android:drawablePadding="8dp"
                        android:text="Vendedor"
                        android:textAllCaps="false"
                        android:textColor="@color/gray_900"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/imgLock"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_lock_open_variant_white_24dp"
                        app:tint="@color/gray_600" />

                    <Button
                        android:id="@+id/btnElegirCliente"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawableLeft="@drawable/ic_human_male_female_white_36dp"
                        android:drawablePadding="8dp"
                        android:text="Cliente"
                        android:textAllCaps="false"
                        android:textColor="@color/gray_900"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnZonaServicio"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:textColor="@color/gray_900"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnModoVenta"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:textColor="@color/gray_900"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Cart Summary & Checkout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_large">

                    <LinearLayout
                        android:id="@+id/linearLayoutBtnDetalleVenta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/layoutInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtCantidadProducto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/pin_button_background"
                                android:backgroundTint="@color/gray_100"
                                android:drawableLeft="@drawable/car_sale"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/colorPrimary"
                                android:gravity="center"
                                android:padding="12dp"
                                android:text="x0"
                                android:textColor="@color/gray_900"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/content_Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtNombreUltimoProductoEnCarrito"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Detalle de venta"
                                    android:textColor="@color/gray_900"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtPrecioUltimoProductoEnCarrito"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Presiona aquí"
                                    android:textColor="@color/status_success"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnCobrar"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:backgroundTint="@color/colorPrimary"
                        android:minWidth="140dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:text="Cobrar\nS/0.00"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/radius_medium" />

                </LinearLayout>

                <!-- Toggle Visual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp">

                    <ImageButton
                        android:id="@+id/imgArrowDisplay"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="64dp"
                        android:layout_height="32dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/arrowdisplay"
                        app:tint="@color/gray_400" />
                </LinearLayout>

                <!-- Main Content -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.sothree.slidinguppanel.SlidingUpPanelLayout
                        android:id="@+id/sliding_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="top"
                        app:umanoClipPanel="true"
                        app:umanoDragView="@+id/linearContenedorVenta"
                        app:umanoOverlay="true"
                        app:umanoPanelHeight="1dp"
                        app:umanoScrollableView="@id/rvCarritoVenta"
                        app:umanoShadowHeight="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <!-- NORMAL SALES (Tablet Portrait) -->
                            <RelativeLayout
                                android:id="@+id/content_venta1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:padding="@dimen/spacing_medium">

                                        <ImageButton
                                            android:id="@+id/imgBackGrid"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            app:srcCompat="@drawable/arrow_back_grid" />

                                        <ImageButton
                                            android:id="@+id/imgTipoVistaLista"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            app:srcCompat="@drawable/grid" />

                                        <ImageButton
                                            android:id="@+id/imgBtnScan"
                                            style="@style/AppTheme.Button.Icon"
                                            android:layout_width="56dp"
                                            android:layout_height="56dp"
                                            app:srcCompat="@drawable/ic_barcode_scan_white_24dp" />

                                        <androidx.appcompat.widget.SearchView
                                            android:id="@+id/edtSearchProduct"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="16dp"
                                            android:layout_weight="1"
                                            android:background="@drawable/pin_button_background"
                                            android:backgroundTint="@color/white"
                                            app:iconifiedByDefault="false"
                                            app:queryHint="Buscar producto..." />

                                    </LinearLayout>

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1">

                                        <RelativeLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent">

                                            <Spinner
                                                android:id="@+id/spinnerCategoria"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@color/white"
                                                android:visibility="gone" />

                                            <GridView
                                                android:id="@+id/gv_Categorias"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_below="@id/spinnerCategoria"
                                                android:numColumns="4"
                                                android:padding="16dp"
                                                android:horizontalSpacing="16dp"
                                                android:verticalSpacing="16dp"
                                                android:visibility="gone" />

                                            <androidx.recyclerview.widget.RecyclerView
                                                android:id="@+id/rvProductsInSale"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_below="@id/spinnerCategoria"
                                                android:padding="8dp"
                                                android:visibility="visible" />

                                            <androidx.recyclerview.widget.RecyclerView
                                                android:id="@+id/rvGridarticulosVenta"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:padding="8dp"
                                                android:visibility="gone" />

                                            <GridView
                                                android:id="@+id/gv_articulosVenta"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:layout_below="@id/spinnerCategoria"
                                                android:columnWidth="120dp"
                                                android:numColumns="auto_fit"
                                                android:padding="16dp"
                                                android:visibility="gone" />

                                            <TextView
                                                android:id="@+id/txtTextoCarrito"
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:gravity="center"
                                                android:padding="48dp"
                                                android:text="No hay productos en el Inventario"
                                                android:textColor="@color/gray_500"
                                                android:textSize="24sp"
                                                android:textStyle="bold"
                                                android:visibility="gone"
                                                app:drawableTopCompat="@drawable/inventory" />

                                            <ProgressBar
                                                android:id="@+id/pbPedido"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_centerInParent="true"
                                                android:visibility="gone" />

                                        </RelativeLayout>

                                        <com.wang.avi.AVLoadingIndicatorView
                                            android:id="@+id/avi"
                                            style="@style/AVLoadingIndicatorView"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            app:indicatorColor="@color/colorPrimary"
                                            app:indicatorName="BallScaleMultipleIndicator" />
                                    </FrameLayout>
                                </LinearLayout>
                            </RelativeLayout>

                            <!-- VEHICLE (Tablet Portrait) -->
                            <RelativeLayout
                                android:id="@+id/content_venta2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="visible">

                                <ScrollView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/spacing_large">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <!-- Header Stats -->
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:gravity="center"
                                            android:orientation="horizontal">

                                            <androidx.cardview.widget.CardView
                                                android:id="@+id/content_aforo"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                app:cardBackgroundColor="#3D5AFE"
                                                app:cardCornerRadius="@dimen/radius_large">

                                                <LinearLayout
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:gravity="center"
                                                    android:orientation="vertical"
                                                    android:padding="24dp">

                                                    <TextView
                                                        android:id="@+id/txtAforoLibre"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="0"
                                                        android:textColor="@color/white"
                                                        android:textSize="48sp"
                                                        android:textStyle="bold" />

                                                    <TextView
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:text="Espacios Libres"
                                                        android:textColor="@color/white"
                                                        android:textSize="14sp" />
                                                </LinearLayout>
                                            </androidx.cardview.widget.CardView>

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="32dp"
                                                android:orientation="vertical">

                                                <TextClock
                                                    android:id="@+id/textClock"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:format12Hour="hh:mm:ss a"
                                                    android:textColor="@color/gray_900"
                                                    android:textSize="32sp"
                                                    android:textStyle="bold" />

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Hora del dispositivo"
                                                    android:textColor="@color/gray_600"
                                                    android:textSize="16sp" />
                                            </LinearLayout>
                                        </LinearLayout>

                                        <!-- Plate Input -->
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="48dp"
                                            app:cardCornerRadius="@dimen/radius_large">

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center_vertical"
                                                android:padding="24dp">

                                                <ImageButton
                                                    android:id="@+id/btnScanPlaca"
                                                    style="@style/AppTheme.Button.Icon"
                                                    android:layout_width="64dp"
                                                    android:layout_height="64dp"
                                                    app:srcCompat="@drawable/ic_barcode_scan_white_36dp"
                                                    app:tint="@color/colorPrimary" />

                                                <EditText
                                                    android:id="@+id/edtPlaca"
                                                    android:layout_width="0dp"
                                                    android:layout_height="wrap_content"
                                                    android:layout_weight="1"
                                                    android:layout_marginStart="24dp"
                                                    android:background="@null"
                                                    android:hint="ABC-123"
                                                    android:textAllCaps="true"
                                                    android:textColor="@color/gray_900"
                                                    android:textSize="32sp"
                                                    android:textStyle="bold" />

                                                <ImageView
                                                    android:id="@+id/imgTipoLista"
                                                    android:layout_width="96dp"
                                                    android:layout_height="96dp"
                                                    android:layout_marginStart="24dp"
                                                    android:padding="8dp"
                                                    android:background="@drawable/pin_button_background"
                                                    android:backgroundTint="@color/gray_100"
                                                    app:srcCompat="@drawable/ic_folder_open_outline_grey600_48dp" />
                                            </LinearLayout>
                                        </androidx.cardview.widget.CardView>

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="48dp"
                                            android:orientation="horizontal">

                                            <Button
                                                android:id="@+id/btnTipoLista"
                                                style="@style/Widget.MaterialComponents.Button"
                                                android:layout_width="0dp"
                                                android:layout_height="72dp"
                                                android:layout_weight="2"
                                                android:backgroundTint="@color/colorPrimary"
                                                android:text="PROCESAR"
                                                android:textSize="20sp" />

                                            <Button
                                                android:id="@+id/btnHabMod"
                                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                                android:layout_width="0dp"
                                                android:layout_height="72dp"
                                                android:layout_marginStart="24dp"
                                                android:layout_weight="2"
                                                android:text="EDITAR"
                                                android:textSize="20sp" />

                                            <ImageButton
                                                android:id="@+id/btnLimpiar"
                                                style="@style/AppTheme.Button.Icon"
                                                android:layout_width="72dp"
                                                android:layout_height="72dp"
                                                android:layout_marginStart="24dp"
                                                android:background="@drawable/pin_button_background"
                                                android:backgroundTint="@color/gray_200"
                                                app:srcCompat="@drawable/ic_broom_white_36dp" />
                                        </LinearLayout>

                                        <!-- Status Indicator -->
                                        <TextView
                                            android:id="@+id/txtEstadoPermitir"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="64dp"
                                            android:gravity="center"
                                            android:text="ENTRA"
                                            android:textColor="@color/colorPrimary"
                                            android:textSize="64sp"
                                            android:textStyle="bold" />

                                        <!-- Hidden IDs -->
                                        <EditText android:id="@+id/edtHoraIngreso" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtHoraSalida" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtTiempoTranscurrido" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtEtapaCont" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtEspaciosLibres" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <EditText android:id="@+id/edtObservacion" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <ImageButton android:id="@+id/btnHoraInit" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                        <ImageButton android:id="@+id/btnHoraFin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                                    </LinearLayout>
                                </ScrollView>
                            </RelativeLayout>
                        </LinearLayout>

                        <!-- Cart Detail (Tablet Portrait) -->
                        <RelativeLayout
                            android:id="@+id/linearContenedorVenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:elevation="16dp">

                            <View
                                android:layout_width="60dp"
                                android:layout_height="4dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="12dp"
                                android:background="@color/gray_300" />

                            <LinearLayout
                                android:id="@+id/contentButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/rvCarritoVenta"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="24dp">

                                <Button
                                    android:id="@+id/btnCancelarVenta"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="ANULAR"
                                    android:textColor="@color/status_error"
                                    android:textSize="18sp" />

                                <ImageButton
                                    android:id="@+id/btnOpenGuardarPedido"
                                    style="@style/AppTheme.Button.Icon"
                                    android:layout_width="64dp"
                                    android:layout_height="64dp"
                                    android:background="@drawable/pin_button_background"
                                    android:backgroundTint="@color/gray_100"
                                    app:srcCompat="@drawable/save_white"
                                    app:tint="@color/colorPrimary" />

                                <TextView
                                    android:id="@+id/txtDescuentoPrecioVenta"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="32dp"
                                    android:layout_weight="1.5"
                                    android:drawableLeft="@drawable/percent1"
                                    android:drawablePadding="16dp"
                                    android:gravity="center_vertical"
                                    android:text="S/0.00"
                                    android:textColor="@color/status_success"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvCarritoVenta"
                                android:layout_width="match_parent"
                                android:layout_height="450dp"
                                android:clipToPadding="false"
                                android:paddingBottom="16dp" />

                        </RelativeLayout>
                    </com.sothree.slidinguppanel.SlidingUpPanelLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
